<UserControl x:Class="lexicon_latina.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:lexicon_latina.ViewModels"
             Background="Transparent">

    <UserControl.DataContext>
        <vm:HistoryViewModel/>
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Arama Geçmişi"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#e0c97f"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="Son 50 arama"
                       FontSize="11"
                       Foreground="#444460"
                       VerticalAlignment="Center"/>
        </Grid>
        
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SearchEntryCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder"
                                            BorderBrush="#1e1e38"
                                            BorderThickness="0,0,0,1"
                                            Padding="4,10"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="🕐"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.5"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InputTurkish}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="#e0c97f"/>
                                                <TextBlock Text="{Binding TranslatedWord}"
                                                           FontSize="12"
                                                           Foreground="#666680"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SearchedAtDisplay}"
                                                       FontSize="11"
                                                       Foreground="#333350"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1a1a32"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#222244"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,60,0,0">
                                                <TextBlock Text="🕐"
                                                           FontSize="48"
                                                           HorizontalAlignment="Center"
                                                           Opacity="0.2"/>
                                                <TextBlock Text="Henüz arama yapılmadı."
                                                           FontSize="14"
                                                           Foreground="#333350"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,14,0,0"/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
