<Window x:Class="lexicon_latina.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:lexicon_latina.ViewModels"
        xmlns:views="clr-namespace:lexicon_latina.Views"
        Title="Lexicon Latina" Height="660" Width="900"
        Icon="/lexicon-latina.ico"
        MinWidth="800" MinHeight="550"
        Background="#0f0f1a"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:ShellViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#a2a2c0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c32"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2d2d48"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e81123"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#c4101e"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabCard" TargetType="Button">
            <Setter Property="Width"  Value="180"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#2e2e50"/>
            <Setter Property="Background" Value="#141428"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background"  Value="#1e1e38"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#e0c97f"/>
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#e0c97f" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#222244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#888899"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Arrow" Text="← " FontSize="14" Foreground="#888899"/>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                       FontSize="13" Foreground="#888899"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow"  Property="Foreground" Value="#e0c97f"/>
                                <Setter TargetName="Label"  Property="Foreground" Value="#e0c97f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="40" Background="#0c0c16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                <Image Source="/lexicon-latina.ico" Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock Text="Lexicon Latina" 
                           Foreground="#a2a2c0" 
                           FontSize="12" 
                           FontWeight="Medium" 
                           Margin="8,0,0,0" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Simge Durumuna Getir">
                    <TextBlock Text="—" FontSize="11" FontWeight="Bold"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="Ekranı Kapla">
                    <TextBlock x:Name="MaximizeIcon" Text="▢" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource CloseTitleBarButton}" Click="CloseButton_Click" ToolTip="Kapat">
                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <TextBlock Text="LEXICON LATINA"
                               FontSize="32" FontWeight="Bold"
                               Foreground="#e0c97f"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Latince Sözlük"
                               FontSize="13"
                               Foreground="#555570"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,48"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <Button Style="{StaticResource TabCard}"
                                Command="{Binding GoToDictionaryCommand}">
                            <StackPanel>
                                <TextBlock Text="📖" FontSize="48" HorizontalAlignment="Center"
                                           Foreground="#555570"/>
                                <TextBlock Text="Sözlük"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="#e0c97f"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="Kelime ara"
                                           FontSize="13"
                                           Foreground="#555570"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TabCard}"
                                Command="{Binding GoToFavoritesCommand}">
                            <StackPanel>
                                <TextBlock Text="🌟" FontSize="48" 
                                           HorizontalAlignment="Center"
                                           Foreground="Goldenrod"/>
                                <TextBlock Text="Favoriler"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="#e0c97f"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="Kaydedilen kelimeler&#x0a;ve cümleler"
                                           FontSize="13"
                                           Foreground="#555570"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TabCard}"
                                Command="{Binding GoToHistoryCommand}">
                            <StackPanel>
                                <TextBlock Text="🕐" FontSize="48" 
                                           HorizontalAlignment="Center"
                                           Foreground="Gray"/>
                                <TextBlock Text="Geçmiş"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="#e0c97f"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="Son aramalar"
                                           FontSize="13"
                                           Foreground="#555570"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsDictionary, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#0f0f1a" Margin="20,16,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Ana Ekran"
                            Style="{StaticResource BackButton}"
                            Command="{Binding GoHomeCommand}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="📖  Sözlük"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="#e0c97f"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1" Margin="20,12,20,20"
                        Background="#141428"
                        BorderBrush="#2e2e50"
                        BorderThickness="1"
                        CornerRadius="12">
                    <views:DictionaryPage/>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsFavorites, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#0f0f1a" Margin="20,16,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Ana Ekran"
                            Style="{StaticResource BackButton}"
                            Command="{Binding GoHomeCommand}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="⭐  Favoriler"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="#e0c97f"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1" Margin="20,12,20,20"
                        Background="#141428"
                        BorderBrush="#2e2e50"
                        BorderThickness="1"
                        CornerRadius="12">
                    <views:FavoritesPage/>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#0f0f1a" Margin="20,16,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Ana Ekran"
                            Style="{StaticResource BackButton}"
                            Command="{Binding GoHomeCommand}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="🕐  Geçmiş"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="#e0c97f"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1" Margin="20,12,20,20"
                        Background="#141428"
                        BorderBrush="#2e2e50"
                        BorderThickness="1"
                        CornerRadius="12">
                    <views:HistoryPage/>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
