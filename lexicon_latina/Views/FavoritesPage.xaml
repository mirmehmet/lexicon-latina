<UserControl x:Class="lexicon_latina.Views.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:lexicon_latina.ViewModels"
             Background="Transparent">

    <UserControl.DataContext>
        <vm:FavoritesViewModel />
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0"
                   Text="Favori Kelimeler"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#e0c97f"
                   Margin="0,0,0,16"/>
        
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding NoFavorites, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="⭐"
                       FontSize="52"
                       HorizontalAlignment="Center"
                       Opacity="0.25"/>
            <TextBlock Text="Henüz favori kelime yok."
                       FontSize="14"
                       Foreground="#444460"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>
            <TextBlock Text="Sözlük sayfasındaki kelimelerin yanındaki yıldız ikonuna tıklayarak favorilerinize ekleyebilirsiniz."
                       FontSize="12"
                       Foreground="#444460"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>
        
        <Border Grid.Row="1"
                BorderBrush="#2e2e50"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Favorites}"
                              Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#2a2a4a"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Word}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#e0c97f"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PartOfSpeech}"
                                               FontSize="13"
                                               Foreground="#888888"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ShortMeaning}"
                                               FontSize="13"
                                               Foreground="#cccccc"
                                               TextWrapping="Wrap"/>
                                    
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Command="{Binding DataContext.PlayTtsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,12,0"
                                                    ToolTip="Sesli Telaffuz">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="PlayTxt" Text="🔊" FontSize="16" Foreground="#444460" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PlayTxt" Property="Foreground" Value="#e0c97f"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,12,0"
                                                    ToolTip="Kelimeyi Panoya Kopyala">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="CopyTxt" Text="📋" FontSize="16" Foreground="#444460" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CopyTxt" Property="Foreground" Value="#e0c97f"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Favorilerden Kaldır">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="StarTxt" Text="★" FontSize="22" Foreground="#e0c97f" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="StarTxt" Property="Text" Value="☆"/>
                                                                <Setter TargetName="StarTxt" Property="Foreground" Value="#ff5555"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
