<UserControl x:Class="lexicon_latina.Views.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:lexicon_latina.ViewModels"
             Background="Transparent">

    <UserControl.DataContext>
        <vm:FavoritesViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="TabHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Tab Selector Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <!-- Kelimeler Tab Button -->
                <Button Content="Kelimeler"
                        Command="{Binding ShowWordsTabCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowWordsTab}" Value="True">
                                    <Setter Property="Foreground" Value="#e0c97f"/>
                                    <Setter Property="BorderBrush" Value="#e0c97f"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Cümleler Tab Button -->
                <Button Content="Cümleler"
                        Command="{Binding ShowSentencesTabCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSentencesTab}" Value="True">
                                    <Setter Property="Foreground" Value="#e0c97f"/>
                                    <Setter Property="BorderBrush" Value="#e0c97f"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- ==================== TAB 1: KELİMELER ==================== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowWordsTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding NoFavorites, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="⭐"
                           FontSize="52"
                           HorizontalAlignment="Center"
                           Opacity="0.25"/>
                <TextBlock Text="Henüz favori kelime yok."
                           FontSize="14"
                           Foreground="#444460"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
                <TextBlock Text="Sözlük sayfasındaki kelimelerin yanındaki yıldız ikonuna tıklayarak favorilerinize ekleyebilirsiniz."
                           FontSize="12"
                           Foreground="#444460"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <Border BorderBrush="#2e2e50"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Favorites}"
                                  Background="Transparent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#2a2a4a"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,12"
                                        Cursor="Hand"
                                        ToolTip="Örnek cümleleri görmek için tıklayın">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#121226"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.ShowSentencesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Word Display -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Word}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#e0c97f"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PartOfSpeech}"
                                                       FontSize="13"
                                                       Foreground="#888888"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ShortMeaning}"
                                                       FontSize="13"
                                                       Foreground="#cccccc"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                            
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <!-- Speak Word -->
                                                <Button Command="{Binding DataContext.PlayTtsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Margin="0,0,12,0"
                                                        ToolTip="Sesli Telaffuz">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock x:Name="PlayTxt" Text="🔊" FontSize="16" Foreground="#444460" VerticalAlignment="Center"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="PlayTxt" Property="Foreground" Value="#e0c97f"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Copy Word -->
                                                <Button Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Margin="0,0,12,0"
                                                        ToolTip="Kelimeyi Panoya Kopyala">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock x:Name="CopyTxt" Text="📋" FontSize="16" Foreground="#444460" VerticalAlignment="Center"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CopyTxt" Property="Foreground" Value="#e0c97f"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Remove Word From Favorites -->
                                                <Button Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="Favorilerden Kaldır">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock x:Name="StarTxt" Text="★" FontSize="22" Foreground="#e0c97f" VerticalAlignment="Center"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="StarTxt" Property="Text" Value="☆"/>
                                                                    <Setter TargetName="StarTxt" Property="Foreground" Value="#ff5555"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>

                                            <!-- Chevron Indicator -->
                                            <TextBlock Grid.Column="4"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▼"/>
                                                        <Setter Property="Foreground" Value="#444460"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text" Value="▲"/>
                                                                <Setter Property="Foreground" Value="#e0c97f"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Expanded sentences area -->
                                        <Border Margin="0,12,0,0"
                                                Padding="16,14"
                                                Background="#0e0e1a"
                                                BorderBrush="#2a2a4a"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel>
                                                <!-- Header -->
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="📖 Örnek Cümleler" 
                                                               FontSize="13" 
                                                               FontWeight="Bold" 
                                                               Foreground="#e0c97f" 
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Loading State -->
                                                <StackPanel Visibility="{Binding IsLoadingSentences, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Margin="0,12"
                                                            HorizontalAlignment="Center">
                                                    <ProgressBar Width="120" Height="2" IsIndeterminate="True" Foreground="#e0c97f" Background="#1a1a2e" BorderThickness="0"/>
                                                    <TextBlock Text="Tatoeba'dan örnek cümleler yükleniyor..." 
                                                               Foreground="#8888aa" 
                                                               FontSize="12" 
                                                               Margin="0,8,0,0" 
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Status/Warning Message -->
                                                <TextBlock Text="{Binding SentencesStatusMessage}"
                                                           Foreground="#e0c97f"
                                                           FontSize="12"
                                                           FontStyle="Italic"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                                <Trigger Property="Text" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Sentences List -->
                                                <ItemsControl ItemsSource="{Binding Sentences}"
                                                              Background="Transparent">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#1a1a2e" BorderThickness="0,0,0,1" Padding="0,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    
                                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                        <!-- Latin Sentence -->
                                                                        <TextBlock Text="{Binding LatinText}"
                                                                                   FontSize="13.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#ffffff"
                                                                                   TextWrapping="Wrap"/>
                                                                        <!-- Translation -->
                                                                        <TextBlock Text="{Binding TranslationText}"
                                                                                   FontSize="12.5"
                                                                                   Foreground="#aaaaaa"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                    
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <!-- Speak Button -->
                                                                        <Button Command="{Binding DataContext.PlayTtsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding LatinText}"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Cursor="Hand"
                                                                                Margin="0,0,12,0"
                                                                                ToolTip="Cümleyi Seslendir">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <TextBlock x:Name="PlayTxt" Text="🔊" FontSize="14" Foreground="#444460" VerticalAlignment="Center"/>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="PlayTxt" Property="Foreground" Value="#e0c97f"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>

                                                                        <!-- Favorite Button -->
                                                                        <Button Command="{Binding DataContext.ToggleSentenceFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Cursor="Hand"
                                                                                ToolTip="Cümleyi Favorilere Ekle/Kaldır">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <TextBlock x:Name="StarTxt" Text="☆" FontSize="18" Foreground="#444460" VerticalAlignment="Center"/>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsFavorited}" Value="True">
                                                                                            <Setter TargetName="StarTxt" Property="Text" Value="★"/>
                                                                                            <Setter TargetName="StarTxt" Property="Foreground" Value="#e0c97f"/>
                                                                                        </DataTrigger>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="StarTxt" Property="Opacity" Value="0.8"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- ==================== TAB 2: CÜMLELER ==================== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowSentencesTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding NoFavoriteSentences, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="📝"
                           FontSize="52"
                           HorizontalAlignment="Center"
                           Opacity="0.25"/>
                <TextBlock Text="Henüz favori cümle yok."
                           FontSize="14"
                           Foreground="#444460"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
                <TextBlock Text="Sözlük veya favori kelimeler sayfasındaki cümlelerin yanındaki yıldız ikonuna tıklayarak favorilerinize ekleyebilirsiniz."
                           FontSize="12"
                           Foreground="#444460"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <Border BorderBrush="#2e2e50"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasFavoriteSentences, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FavoriteSentences}"
                                  Background="Transparent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#2a2a4a"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#121226"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <!-- Latin Text -->
                                            <TextBlock Text="{Binding LatinText}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#ffffff"
                                                       TextWrapping="Wrap"/>
                                            <!-- Translation Text -->
                                            <TextBlock Text="{Binding TranslationText}"
                                                       FontSize="12.5"
                                                       Foreground="#aaaaaa"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Speak Button -->
                                            <Button Command="{Binding DataContext.PlayTtsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding LatinText}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,12,0"
                                                    ToolTip="Sesli Telaffuz">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="PlayTxt" Text="🔊" FontSize="15" Foreground="#444460" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PlayTxt" Property="Foreground" Value="#e0c97f"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Copy Button -->
                                            <Button Command="{Binding DataContext.CopySentenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,12,0"
                                                    ToolTip="Cümleyi Kopyala">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="CopyTxt" Text="📋" FontSize="15" Foreground="#444460" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CopyTxt" Property="Foreground" Value="#e0c97f"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Remove Button -->
                                            <Button Command="{Binding DataContext.RemoveFavoriteSentenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Favorilerden Kaldır">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="StarTxt" Text="★" FontSize="20" Foreground="#e0c97f" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="StarTxt" Property="Text" Value="☆"/>
                                                                <Setter TargetName="StarTxt" Property="Foreground" Value="#ff5555"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
